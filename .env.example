# MicroBatch Environment Variables Template

# Backend (Web Service on Render)
PORT=3001
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require
JWT_SECRET=replace_with_a_secure_random_string_in_production
CLIENT_URL=https://microbatch-client.onrender.com

# Frontend (Static Site on Render)
VITE_API_URL=https://microbatch-server.onrender.com
VITE_SOCKET_URL=https://microbatch-server.onrender.com
